thm_red="{{colors.error.default.hex}}"
thm_green="{{colors.tertiary_fixed_dim.default.hex}}"
thm_yellow="{{colors.secondary_fixed_dim.default.hex}}"
thm_blue="{{colors.primary.default.hex}}"
thm_magenta="{{colors.tertiary.default.hex}}"
thm_pink="{{colors.secondary.default.hex}}"
thm_cyan="{{colors.primary_fixed_dim.default.hex}}"
thm_orange="{{colors.primary_fixed_dim.default.hex}}"
