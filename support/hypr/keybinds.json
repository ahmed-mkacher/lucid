{
    "version": 1,
    "binds": [
    { "id": "launcher", "keys": "SUPER + Super_L", "desc": "App launcher (tap Super)", "category": "Lucid", "type": "exec", "cmd": "qs ipc call launcher toggle", "opts": { "release": true } },
    { "id": "wallpaper", "keys": "SUPER + B", "desc": "Wallpaper picker", "category": "Lucid", "type": "exec", "cmd": "qs ipc call launcher wallpaper" },
    { "id": "theme", "keys": "SUPER + T", "desc": "Theme picker", "category": "Lucid", "type": "exec", "cmd": "qs ipc call launcher theme" },
    { "id": "settings", "keys": "SUPER + I", "desc": "Lucid Settings", "category": "Lucid", "type": "exec", "cmd": "qs ipc call settings toggle" },
    { "id": "bar-toggle", "keys": "SUPER + SHIFT + B", "desc": "Bar: sticky or auto-hide", "category": "Lucid", "type": "exec", "cmd": "qs ipc call settings barautohide" },
    { "id": "keybinds-sheet", "keys": "SUPER + SHIFT + slash", "desc": "Show keybinds", "category": "Lucid", "type": "exec", "cmd": "qs ipc call launcher keybinds" },
    { "id": "moji", "keys": "SUPER + period", "desc": "Emoji picker", "category": "Lucid", "type": "exec", "cmd": "qs ipc call moji toggle" },
    { "id": "overview", "keys": "SUPER + Tab", "desc": "Workspace overview", "category": "Lucid", "type": "exec", "cmd": "qs ipc call workspaces toggle" },
    { "id": "reload", "keys": "CTRL + ALT + R", "desc": "Reload Hyprland and the shell", "category": "Lucid", "type": "exec", "cmd": "$HOME/.config/hypr/scripts/reload.sh" },
    { "id": "session", "keys": "CTRL + ALT + Delete", "desc": "Session screen", "category": "Lucid", "type": "exec", "cmd": "qs ipc call session toggle" },
    { "id": "notifs-clear", "keys": "CTRL + ALT + C", "desc": "Clear notifications", "category": "Lucid", "type": "exec", "cmd": "qs ipc call notifs clear" },
    { "id": "shell-kill", "keys": "CTRL + SUPER + SHIFT + R", "desc": "Kill the shell", "category": "Lucid", "type": "exec", "cmd": "qs kill", "opts": { "release": true } },
    { "id": "shell-restart", "keys": "CTRL + SUPER + ALT + R", "desc": "Restart the shell", "category": "Lucid", "type": "exec", "cmd": "qs kill; sleep .1; qs -d", "opts": { "release": true } },
    { "id": "sleep", "keys": "SUPER + SHIFT + Z", "desc": "Suspend-then-hibernate", "category": "Lucid", "type": "exec", "cmd": "systemctl suspend-then-hibernate", "opts": { "locked": true } },
    { "id": "paste-clip", "keys": "CTRL + SHIFT + ALT + V", "desc": "Type last clipboard entry", "category": "Lucid", "type": "exec", "cmd": "sleep 0.5s && ydotool type -d 1 \"$(cliphist list | head -1 | cliphist decode)\"", "opts": { "locked": true } },
    { "id": "clipboard", "keys": "SUPER + V", "desc": "Clipboard history", "category": "Lucid", "type": "exec", "cmd": "qs ipc call launcher clipboard" },
    { "id": "lock-slash", "keys": "SUPER + slash", "desc": "Lock screen", "category": "Lucid", "type": "exec", "cmd": "qs ipc call lock lock" },
    { "id": "files", "keys": "SUPER + E", "desc": "File manager", "category": "Apps", "type": "exec", "cmd": "nautilus" },
    { "id": "terminal", "keys": "SUPER + return", "desc": "Terminal", "category": "Apps", "type": "exec", "cmd": "foot" },
    { "id": "editor", "keys": "SUPER + C", "desc": "Editor", "category": "Apps", "type": "exec", "cmd": "zeditor" },
    { "id": "browser", "keys": "SUPER + W", "desc": "Zen browser (scratchpad)", "category": "Apps", "type": "lua", "lua": "specials.launch(\"special\", \"zen-browser\")" },
    { "id": "exit", "keys": "CTRL + SUPER + M", "desc": "Exit Hyprland", "category": "Windows", "type": "exec", "cmd": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'" },
    { "id": "resize", "keys": "SUPER + mouse:273", "desc": "Resize window (drag)", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.resize()", "opts": { "mouse": true } },
    { "id": "switch-next", "keys": "ALT + Tab", "desc": "Window switcher", "category": "Windows", "type": "exec", "cmd": "qs ipc call switcher next" },
    { "id": "switch-prev", "keys": "SHIFT + ALT + Tab", "desc": "Window switcher (back)", "category": "Windows", "type": "exec", "cmd": "qs ipc call switcher prev" },
    { "id": "focus-left", "keys": "SUPER + H", "desc": "Focus left", "category": "Windows", "type": "lua", "lua": "hl.dsp.focus({ direction = \"left\" })" },
    { "id": "focus-right", "keys": "SUPER + L", "desc": "Focus right", "category": "Windows", "type": "lua", "lua": "hl.dsp.focus({ direction = \"right\" })" },
    { "id": "move-left-vim", "keys": "SUPER + SHIFT + H", "desc": "Move window left", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.move({ direction = \"left\" })" },
    { "id": "move-right-vim", "keys": "SUPER + SHIFT + L", "desc": "Move window right", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.move({ direction = \"right\" })" },
    { "id": "move-up-vim", "keys": "SUPER + SHIFT + K", "desc": "Move window up", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.move({ direction = \"up\" })" },
    { "id": "move-down-vim", "keys": "SUPER + SHIFT + J", "desc": "Move window down", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.move({ direction = \"down\" })" },
    { "id": "resize-w-shrink", "keys": "SUPER + Minus", "desc": "Shrink window", "category": "Windows", "type": "lua", "lua": "function() local w = hl.get_active_window(); if w and w.size then hl.dispatch(hl.dsp.window.resize({ x = w.size.x * -0.1, y = 0, relative = true })) end end", "opts": { "repeating": true } },
    { "id": "resize-w-grow", "keys": "SUPER + Equal", "desc": "Grow window", "category": "Windows", "type": "lua", "lua": "function() local w = hl.get_active_window(); if w and w.size then hl.dispatch(hl.dsp.window.resize({ x = w.size.x * 0.1, y = 0, relative = true })) end end", "opts": { "repeating": true } },
    { "id": "resize-h-shrink", "keys": "SUPER + SHIFT + Minus", "desc": "Shrink window height", "category": "Windows", "type": "lua", "lua": "function() local w = hl.get_active_window(); if w and w.size then hl.dispatch(hl.dsp.window.resize({ x = 0, y = w.size.y * -0.1, relative = true })) end end", "opts": { "repeating": true } },
    { "id": "resize-h-grow", "keys": "SUPER + SHIFT + Equal", "desc": "Grow window height", "category": "Windows", "type": "lua", "lua": "function() local w = hl.get_active_window(); if w and w.size then hl.dispatch(hl.dsp.window.resize({ x = 0, y = w.size.y * 0.1, relative = true })) end end", "opts": { "repeating": true } },
    { "id": "drag-move", "keys": "SUPER + G", "desc": "Move window (drag)", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.drag()", "opts": { "mouse": true } },
    { "id": "float", "keys": "SUPER + Z", "desc": "Toggle floating", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.float({ action = \"toggle\" })" },
    { "id": "center", "keys": "CTRL + SUPER + Backslash", "desc": "Center window", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.center()" },
    { "id": "fullscreen", "keys": "SUPER + F", "desc": "Fullscreen", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.fullscreen({ mode = \"fullscreen\" })" },
    { "id": "close", "keys": "SUPER + Q", "desc": "Close window", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.close()" },
    { "id": "fullscreen-max", "keys": "SUPER + M", "desc": "Bordered fullscreen (maximized)", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.fullscreen({ mode = \"maximized\" })" },
    { "id": "pin", "keys": "SUPER + P", "desc": "Pin window", "category": "Windows", "type": "lua", "lua": "hl.dsp.window.pin()" },
    { "id": "focus-up", "keys": "SUPER + K", "desc": "Focus up", "category": "Windows", "type": "lua", "lua": "hl.dsp.focus({ direction = \"up\" })" },
    { "id": "focus-down", "keys": "SUPER + J", "desc": "Focus down", "category": "Windows", "type": "lua", "lua": "hl.dsp.focus({ direction = \"down\" })" },
    { "id": "ws-focus", "keys": "SUPER + {key}", "desc": "Workspace {n}", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.focus({ workspace = {n} })", "each": "workspace" },
    { "id": "ws-move", "keys": "SUPER + SHIFT + {key}", "desc": "Move window to workspace {n}", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = {n} })", "each": "workspace" },
    { "id": "special-scratchpad-move", "keys": "SUPER + SHIFT + S", "desc": "Move window to scratchpad", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = \"special:special\" })" },
    { "id": "special-comms", "keys": "SUPER + SHIFT + D", "desc": "Move window to comms workspace", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = \"special:comms\" })" },
    { "id": "special-todo", "keys": "SUPER + SHIFT + R", "desc": "Move window to to-do workspace", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = \"special:todo\" })" },
    { "id": "special-music", "keys": "SUPER + A", "desc": "Music workspace", "category": "Workspaces", "type": "lua", "lua": "specials.show(\"music\")" },
    { "id": "special-sysmon", "keys": "SUPER + X", "desc": "System monitor workspace", "category": "Workspaces", "type": "lua", "lua": "specials.show(\"sysmon\")" },
    { "id": "win-to-music", "keys": "SUPER + SHIFT + A", "desc": "Move window to music workspace", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = \"special:music\" })" },
    { "id": "win-to-sysmon", "keys": "SUPER + SHIFT + X", "desc": "Move window to system monitor workspace", "category": "Workspaces", "type": "lua", "lua": "hl.dsp.window.move({ workspace = \"special:sysmon\" })" },
    { "id": "special-scratchpad", "keys": "SUPER + S", "desc": "Scratchpad workspace", "category": "Workspaces", "type": "lua", "lua": "specials.show(\"special\")" },
    { "id": "show-comms", "keys": "SUPER + D", "desc": "Comms workspace (show, no launch)", "category": "Workspaces", "type": "lua", "lua": "specials.show(\"comms\")" },
    { "id": "show-todo", "keys": "SUPER + R", "desc": "To-do workspace", "category": "Workspaces", "type": "lua", "lua": "specials.show(\"todo\")" },
    { "id": "xf86-mute", "keys": "XF86AudioMute", "desc": "Mute", "category": "Media keys", "type": "exec", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "opts": { "locked": true } },
    { "id": "xf86-vol-down", "keys": "XF86AudioLowerVolume", "desc": "Volume down", "category": "Media keys", "type": "exec", "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-", "opts": { "locked": true, "repeating": true } },
    { "id": "xf86-vol-up", "keys": "XF86AudioRaiseVolume", "desc": "Volume up", "category": "Media keys", "type": "exec", "cmd": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+", "opts": { "locked": true, "repeating": true } },
    { "id": "xf86-mic-mute", "keys": "XF86AudioMicMute", "desc": "Mute microphone", "category": "Media keys", "type": "exec", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "opts": { "locked": true } },
    { "id": "xf86-bright-down", "keys": "XF86MonBrightnessDown", "desc": "Brightness down", "category": "Media keys", "type": "exec", "cmd": "brightnessctl -e4 -n2 set 5%-", "opts": { "locked": true, "repeating": true } },
    { "id": "xf86-bright-up", "keys": "XF86MonBrightnessUp", "desc": "Brightness up", "category": "Media keys", "type": "exec", "cmd": "brightnessctl -e4 -n2 set 5%+", "opts": { "locked": true, "repeating": true } },
    { "id": "xf86-next", "keys": "XF86AudioNext", "desc": "Next track", "category": "Media keys", "type": "exec", "cmd": "playerctl next", "opts": { "locked": true } },
    { "id": "xf86-pause", "keys": "XF86AudioPause", "desc": "Play / pause", "category": "Media keys", "type": "exec", "cmd": "playerctl play-pause", "opts": { "locked": true } },
    { "id": "xf86-play", "keys": "XF86AudioPlay", "desc": "Play / pause", "category": "Media keys", "type": "exec", "cmd": "playerctl play-pause", "opts": { "locked": true } },
    { "id": "xf86-prev", "keys": "XF86AudioPrev", "desc": "Previous track", "category": "Media keys", "type": "exec", "cmd": "playerctl previous", "opts": { "locked": true } },
    { "id": "media-toggle", "keys": "CTRL + SUPER + Space", "desc": "Play / pause", "category": "Media keys", "type": "exec", "cmd": "playerctl play-pause", "opts": { "locked": true } },
    { "id": "media-next", "keys": "CTRL + SUPER + Equal", "desc": "Next track", "category": "Media keys", "type": "exec", "cmd": "playerctl next", "opts": { "locked": true } },
    { "id": "media-prev", "keys": "CTRL + SUPER + Minus", "desc": "Previous track", "category": "Media keys", "type": "exec", "cmd": "playerctl previous", "opts": { "locked": true } },
    { "id": "media-stop", "keys": "XF86AudioStop", "desc": "Stop", "category": "Media keys", "type": "exec", "cmd": "playerctl stop", "opts": { "locked": true } },
    { "id": "f1-mute", "keys": "F1", "desc": "Mute", "category": "Function keys", "type": "exec", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "opts": { "locked": true } },
    { "id": "f2-vol-down", "keys": "F2", "desc": "Volume down", "category": "Function keys", "type": "exec", "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-", "opts": { "locked": true, "repeating": true } },
    { "id": "f3-vol-up", "keys": "F3", "desc": "Volume up", "category": "Function keys", "type": "exec", "cmd": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+", "opts": { "locked": true, "repeating": true } },
    { "id": "f4-mic-mute", "keys": "F4", "desc": "Mute microphone", "category": "Function keys", "type": "exec", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "opts": { "locked": true } },
    { "id": "f5-bright-down", "keys": "F5", "desc": "Brightness down", "category": "Function keys", "type": "exec", "cmd": "brightnessctl -e4 -n2 set 5%-", "opts": { "locked": true, "repeating": true } },
    { "id": "f6-bright-up", "keys": "F6", "desc": "Brightness up", "category": "Function keys", "type": "exec", "cmd": "brightnessctl -e4 -n2 set 5%+", "opts": { "locked": true, "repeating": true } },
    { "id": "f8-rfkill", "keys": "F8", "desc": "Toggle all radios", "category": "Function keys", "type": "exec", "cmd": "rfkill toggle all", "opts": { "locked": true } },
    { "id": "f10-lock", "keys": "F10", "desc": "Lock screen", "category": "Function keys", "type": "exec", "cmd": "qs ipc call lock lock", "opts": { "locked": true } },
    { "id": "snap-region", "keys": "Print", "desc": "Region screenshot", "category": "Screenshots", "type": "exec", "cmd": "qs ipc call snap toggle", "opts": { "locked": true } },
    { "id": "snap-region-ctrl-s", "keys": "CTRL + SUPER + S", "desc": "Region screenshot", "category": "Screenshots", "type": "exec", "cmd": "qs ipc call snap toggle", "opts": { "locked": true } },
    { "id": "snap-full", "keys": "SUPER + Print", "desc": "Full screenshot", "category": "Screenshots", "type": "exec", "cmd": "qs ipc call screenshot full", "opts": { "locked": true } },
    { "id": "snap-text", "keys": "SUPER + SHIFT + T", "desc": "Copy text from a region (OCR)", "category": "Screenshots", "type": "exec", "cmd": "qs ipc call snap text", "opts": { "locked": true } },
    { "id": "snap-color", "keys": "SUPER + SHIFT + C", "desc": "Pick a colour from the screen", "category": "Screenshots", "type": "exec", "cmd": "qs ipc call snap color", "opts": { "locked": true } }
    ]
}
